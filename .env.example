# ─── Required ────────────────────────────────────────────────────────────────
# Bot API key from Echoed: Settings → Bot Profile. Starts with "zbot_".
ECHOED_BOT_TOKEN=zbot_your_api_key_here

# ─── Optional: endpoints (defaults match the official docs) ───────────────────
ECHOED_API_BASE=https://go.echoed.gg/v1/bots
ECHOED_SOCKET_URL=https://socket.echoed.gg

# ─── Optional: behaviour ─────────────────────────────────────────────────────
# Command prefix. "/play ..." by default.
COMMAND_PREFIX=/

# Echoed has no API to read which voice channel a user is sitting in, so the bot
# cannot follow the caller automatically. Resolution order for /play:
#   1. the channel set by `/join <name|id>` in that server
#   2. DEFAULT_VOICE_CHANNEL below, if it matches a channel in the server
#   3. the server's only voice channel, if there is exactly one
# Accepts a channel id or a channel name.
DEFAULT_VOICE_CHANNEL=

# Playback volume 0-200 (%), applied in software.
DEFAULT_VOLUME=100

# Live-edit the "now playing" embed with a progress bar. Costs 1 API request per
# interval per active server; the API budget is 120 requests/minute in total.
NOW_PLAYING_PROGRESS=true
NOW_PLAYING_INTERVAL_MS=10000

# Leave the voice channel after this long with an empty queue. 0 disables.
IDLE_DISCONNECT_MS=300000

# Max tracks accepted from a single playlist/album link.
MAX_PLAYLIST_TRACKS=100

# ─── Optional: binaries ──────────────────────────────────────────────────────
# Leave empty to use ./bin/yt-dlp[.exe] from `npm run setup`, else PATH lookup.
YTDLP_PATH=
# Leave empty to use the bundled ffmpeg-static binary.
FFMPEG_PATH=

# Pass cookies to yt-dlp for age/region-locked tracks, e.g. "chrome" or "firefox".
YTDLP_COOKIES_FROM_BROWSER=
# Or a Netscape-format cookie file.
YTDLP_COOKIE_FILE=

# ─── Optional: logging ───────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info

# ─── Optional: one-time bot install ──────────────────────────────────────────
# Only needed until the bot is approved. Echoed's API returns 403
# "bot_not_approved" until the bot either passes review or is installed on a
# server. Two ways to install it before approval:
#
# 1. Development token (what the web client itself does, and by far the easier
#    path). In the client: server → Server Settings → Bots → the pale outlined
#    button left of the bright "browse bots" one → paste the edev_ token.
#    `npm run install-bot` does the same from the terminal and needs:
DEV_INVITE_TOKEN=
# A session JWT for YOUR account, not the bot's. DevTools → Network → any
# request to go.echoed.gg → copy what follows "Bearer " in Authorization.
# Short-lived; re-grab it if the script reports 401.
ECHOED_USER_JWT=
# The target server's id — it is the <id> in the client URL /servers/<id>.
SERVER_ID=
#
# 2. OAuth2 (`npm run invite`) — the only path the developer docs describe, but
#    it needs its own OAuth2 client and the bot's user id. Register the client
#    in YOUR OWN account (Settings → OAuth2 Apps); a bot account cannot create
#    one. The app acts as you: you hold the bot-management permission, the bot
#    is only the thing being invited. Add this exact redirect URI to it:
#      http://localhost:8787/callback
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# The bot's user id — NOT the zbot_ key. Unreachable through the API while the
# bot is unapproved (/validate and /profile both carry it and are both gated);
# `npm run install-bot` prints it as part of resolving the dev token.
BOT_ID=
# Override only if port 8787 is taken; must match the registered redirect URI.
OAUTH_PORT=8787
OAUTH_REDIRECT_URI=
